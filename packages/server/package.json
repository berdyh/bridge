{
  "name": "@berdyh/bridge-server",
  "version": "0.2.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berdyh/bridge.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/berdyh/bridge/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/berdyh/bridge/issues"
  },
  "type": "module",
  "description": "Runtime-independent bridge server core",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter \"@berdyh/bridge-server^...\" build",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter \"@berdyh/bridge-server^...\" build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@berdyh/bridge-protocol": "workspace:*",
    "hono": "4.13.13"
  }
}
