{
  "name": "@berdyh/bridge-client",
  "version": "0.2.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berdyh/bridge.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/berdyh/bridge/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/berdyh/bridge/issues"
  },
  "type": "module",
  "description": "Browser and headless client SDK",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter \"@berdyh/bridge-client^...\" build",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter \"@berdyh/bridge-client^...\" build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@berdyh/bridge-crypto": "workspace:*",
    "@berdyh/bridge-protocol": "workspace:*",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
