{
  "name": "@berdyh/bridge-server-node",
  "version": "0.2.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berdyh/bridge.git",
    "directory": "packages/server-node"
  },
  "homepage": "https://github.com/berdyh/bridge/tree/main/packages/server-node#readme",
  "bugs": {
    "url": "https://github.com/berdyh/bridge/issues"
  },
  "type": "module",
  "description": "Node adapter: ws relay, in-memory store, stub auth",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter \"@berdyh/bridge-server-node^...\" build",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter \"@berdyh/bridge-server-node^...\" build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@berdyh/bridge-protocol": "workspace:*",
    "@berdyh/bridge-server": "workspace:*",
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
