{
  "name": "@berdyh/bridge-crypto",
  "version": "0.2.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berdyh/bridge.git",
    "directory": "packages/crypto"
  },
  "homepage": "https://github.com/berdyh/bridge/tree/main/packages/crypto#readme",
  "bugs": {
    "url": "https://github.com/berdyh/bridge/issues"
  },
  "type": "module",
  "description": "SPAKE2, X25519/HKDF and the AES-GCM frame codec",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter \"@berdyh/bridge-crypto^...\" build",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter \"@berdyh/bridge-crypto^...\" build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@berdyh/bridge-protocol": "workspace:*",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "jsdom": "30.1.2"
  }
}
