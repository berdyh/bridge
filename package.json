{
  "name": "bridge",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter @berdyh/bridge-e2e test",
    "e2e:cf": "node e2e-cf/run.mjs test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
