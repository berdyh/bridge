{
  "name": "@berdyh/bridge-sample-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sample local plugin",
  "files": [
    "dist",
    "bridge-plugin.json"
  ],
  "main": "dist/plugin.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node build.mjs",
    "pretypecheck": "pnpm --filter \"@berdyh/bridge-sample-plugin^...\" build",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter \"@berdyh/bridge-sample-plugin^...\" build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@berdyh/bridge-protocol": "workspace:*",
    "@berdyh/bridge-plugin-sdk": "workspace:*"
  }
}
